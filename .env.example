# ---------------------------------------------------------------------------
# Atlas Industrial Supply -- example environment
# Copy to backend/.env (and frontend/.env.local) and fill in.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Backend (backend/.env) ------------------------------------------------

# SQLite file backing the synthetic business systems.
ATLAS_DATABASE_URL=sqlite:///./atlas.db

# Shared secret the ElevenLabs webhook tools must send as X-Atlas-Api-Key.
# Leave blank for local development to disable the check entirely.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ATLAS_API_KEY=

# Enables POST /api/demo/reset and the fault injector. Must be false in any
# deployment you would not be happy for a stranger to wipe.
ATLAS_DEMO_MODE=true

# Comma-separated browser origins allowed to call the API directly.
ATLAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

ATLAS_LOG_LEVEL=INFO


# --- Agent provisioning (used by scripts/provision_agent.py) ---------------

# ElevenLabs API key with agents access. Server-side only.
ELEVENLABS_API_KEY=

# Public HTTPS base URL of the backend, as reachable from ElevenLabs.
# ElevenLabs calls the webhook tools from its own servers, so localhost will
# not work -- use a tunnel (e.g. `ngrok http 8000`) or a deployed URL.
ATLAS_PUBLIC_BASE_URL=https://your-tunnel-subdomain.ngrok-free.app
