# Frontend environment — copy to frontend/.env.local

# Agent id printed by scripts/provision_agent.py. Not a secret.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Optional. When set, the browser is issued a per-call conversation token
# instead of connecting with the agent id, and this key never leaves the
# server. Required if the agent is private.
ELEVENLABS_API_KEY=

# Where the FastAPI backend is reachable from this Next.js server.
ATLAS_BACKEND_URL=http://127.0.0.1:8000

# Shared secret the backend expects; must match backend/.env ATLAS_API_KEY.
ATLAS_API_KEY=
